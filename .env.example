# Copy this file to .env at the repo root and fill in your real key.
# Never commit the real .env file.

GROQ_API_KEY=your_groq_api_key_here

# Optional overrides
PORT=3000
GROQ_MODEL=openai/gpt-oss-120b
# Set to "true" to return the static mock from shared/mocks/mock-guidance-action.json
# instead of calling the LLM. Useful hour 1 so teammates can build against a live endpoint.
USE_MOCK_REASON=false
