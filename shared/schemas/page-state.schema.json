{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PageState",
  "type": "object",
  "required": ["goal", "url", "elements", "accessibility_profile"],
  "properties": {
    "goal": { "type": "string" },
    "url": { "type": "string" },
    "accessibility_profile": {
      "type": "string",
      "enum": ["low_vision", "motor", "cognitive_load", "unsure"],
      "description": "Set once by the user in the popup (Person 4), passed through unchanged by Page Mapper and PII Guard. Read by the backend to set baseline support_level and read_aloud."
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role", "label", "state", "rect"],
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "label": { "type": "string" },
          "state": { "type": "string" },
          "rect": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 }
        }
      }
    },
    "history": { "type": "array", "items": { "type": "string" } }
  }
}
